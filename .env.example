# Multi-Tenant Library Management SaaS Environment Configuration

# Server Port
PORT=5000

# JSON Web Token Secret (Change in production)
JWT_SECRET=production_super_secret_jwt_key_please_change_2026_xyz

# SQLite Database Storage Location
DB_PATH=data/library_saas.sqlite

# File Upload Storage Directory
UPLOAD_DIR=uploads

# Gmail SMTP Email Configuration (Free fee reminders without WhatsApp API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Library Management System" <yourgmail@gmail.com>

# Official Meta WhatsApp Cloud API Configuration (Optional)
# If left blank, the platform operates in transparent sandbox test mode
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
